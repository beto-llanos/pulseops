# Run mode: "demo" uses realistic synthetic data. "live" uses real APIs (requires keys below).
PULSEOPS_MODE=demo

# Anthropic Claude API (used for repetition detection and natural-language insights)
ANTHROPIC_API_KEY=

# GitHub (read-only PAT, scope: repo, read:org)
GITHUB_TOKEN=
GITHUB_ORG=

# Google Calendar (OAuth client credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Jira Cloud
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Telegram (for weekly digest)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Currency for all displayed costs
PULSEOPS_CURRENCY=USD
